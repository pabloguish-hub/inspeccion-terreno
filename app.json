{
  "expo": {
    "name": "Inspección ITO — Teck CDA",
    "slug": "inspeccion-terreno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/teck/icono.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000F3F",
        "foregroundImage": "./assets/teck/icono-adaptable.png",
        "monochromeImage": "./assets/teck/icono-monocromo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pabloguish.inspeccionterreno",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/teck/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "La app usa la cámara para tomar las fotos de la inspección.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000F3F",
          "image": "./assets/teck/logo-blanco.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "inspeccionterreno",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f5de7d85-af19-4366-b7cf-6bfc16ed7abc"
      }
    },
    "owner": "pabloguish"
  }
}
